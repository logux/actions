{
  "name": "@logux/actions",
  "version": "0.5.0",
  "description": "Types and action creators for build-in Logux actions",
  "keywords": [
    "crdt",
    "logux",
    "types"
  ],
  "homepage": "https://logux.org/",
  "license": "MIT",
  "author": "Andrey Sitnik <andrey@sitnik.es>",
  "repository": "logux/actions",
  "type": "module",
  "sideEffects": false,
  "types": "./index.d.ts",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test:coverage": "bnt --coverage 100",
    "test:lint": "oxlint",
    "test:types": "check-dts",
    "test:size": "size-limit",
    "test": "pnpm run /^test:/"
  },
  "devDependencies": {
    "@logux/client": "^0.23.2",
    "@logux/core": "^0.10.0",
    "@logux/oxc-configs": "^0.3.3",
    "@size-limit/preset-small-lib": "^12.1.0",
    "@types/ws": "^8.18.1",
    "actions-up": "^1.13.0",
    "better-node-test": "^0.8.4",
    "check-dts": "^1.0.0",
    "clean-publish": "^6.0.5",
    "eslint-plugin-prefer-let": "^4.2.2",
    "nanostores": "^1.2.0",
    "oxlint": "^1.60.0",
    "oxlint-tsgolint": "^0.21.0",
    "size-limit": "^12.1.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  },
  "peerDependencies": {
    "@logux/core": "^0.10.0"
  },
  "size-limit": [
    {
      "import": "{ defineAction }",
      "limit": "51 B"
    }
  ],
  "engines": {
    "node": "^22.0.0 || >=24.0.0"
  }
}
